# Единственный общий ключ Folio и worker. Задайте его также в настройках Folio.
WORKER_API_KEY=CHANGE_ME

# Ссылка из Folio → Настройки → Воркер изображений. Воркер сам опрашивает её.
FOLIO_POLL_URL=https://one.customcraft-mes.ru/folio/image-worker/next

# Новые задания: aitunnel — модель выбирается в настройках Folio; mock — проверка без оплаты.
# До появления ключа aitunnel воркер не забирает новые задания из Folio.
IMAGE_PROVIDER=aitunnel
AITUNNEL_API_KEY=
# Официальный адрес по умолчанию. При постоянных проблемах сети можно выбрать
# https://ru-api.aitunnel.ru/v1; при ошибке соединения воркер переключится сам.
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_CONNECT_TIMEOUT_SECONDS=60
AITUNNEL_READ_TIMEOUT_SECONDS=3600

# Только для завершения старых заданий Nano Banana при миграции.
NANOBANANA_MODE=live
NANOBANANA_API_KEY=

# Производственная локальная или UNC-папка. Сюда файл попадает только после
# согласования макета и действия размещения от Folio. Без папки размещение
# завершится ошибкой; исходник останется в рабочей папке.
PRINT_SHARE_PATH=
